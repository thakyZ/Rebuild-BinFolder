<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Assembly Info">
    <RootNamespace>InitializeBinFolder.Common</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="Build">
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Attributes\DefaultValueNewAttribute.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="Rebuild_BinFolder.Attributes.AssemblyRepositoryOwnerAttribute">
      <_Parameter1>$(RepositoryOwner)</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="Rebuild_BinFolder.Attributes.AssemblyRepositoryNameAttribute">
      <_Parameter1>$(RepositoryName)</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="Exists('$(AppData)\MSRuleSets\sonarlint.editorconfig')">
    <None Include="$(AppData)\MSRuleSets\sonarlint.editorconfig" Link="sonarlint.editorconfig" />
    <EditorConfigFiles Remove="$(AppData)\MSRuleSets\sonarlint.editorconfig" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(AppData)\MSRuleSets\roslynator.editorconfig')">
    <None Include="$(AppData)\MSRuleSets\roslynator.editorconfig" Link="roslynator.editorconfig" />
    <EditorConfigFiles Remove="$(AppData)\MSRuleSets\roslynator.editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Attributes\DefaultValueNewAttribute.cs" />
  </ItemGroup>

</Project>
